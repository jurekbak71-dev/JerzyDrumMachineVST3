"""Jerzy Composer 0.3 - musical Piano Roll composition for FL Studio.
Runs in FL Studio's built-in flpianoroll Python environment.
A deterministic generator: the same settings and seed produce the same notes.
"""
import math
import random
import flpianoroll as flp

MODES = ['Perkusja - groove', 'Bas - riff', 'Akordy - harmonia',
         'Arpeggio - ruch akordow', 'Melodia - muzyczne frazy']
TONICS = ['C', 'C# / Db', 'D', 'D# / Eb', 'E', 'F',
          'F# / Gb', 'G', 'G# / Ab', 'A', 'A# / B (Bb)', 'H (B)']
OCTAVES = ['C2 - niski', 'C3 - sredni niski', 'C4 - srodkowy',
           'C5 - wysoki', 'C6 - bardzo wysoki']
SCALE_NAMES = ['Moll naturalna', 'Dur (major)', 'Dorycka', 'Pentatonika moll',
               'Moll harmoniczna', 'Frygijska', 'Miksolidyjska']
SCALES = [
    [0, 2, 3, 5, 7, 8, 10],
    [0, 2, 4, 5, 7, 9, 11],
    [0, 2, 3, 5, 7, 9, 10],
    [0, 3, 5, 7, 10],
    [0, 2, 3, 5, 7, 8, 11],
    [0, 1, 3, 5, 7, 8, 10],
    [0, 2, 4, 5, 7, 9, 10],
]
PROGRESSION_NAMES = ['Jedna tonika - bez zmian',
                     'Moll: i - VI - III - VII',
                     'Moll: i - iv - V - i',
                     'Pop: I - V - vi - IV',
                     'Jazz: ii - V - I - vi',
                     'Film: i - VII - VI - VII',
                     'Klub: i - III - VII - iv']
PROGRESSIONS = [[0], [0, 5, 2, 6], [0, 3, 4, 0],
                [0, 4, 5, 3], [1, 4, 0, 5], [0, 6, 5, 6],
                [0, 2, 6, 3]]
STYLES = ['Rock', 'Dub / reggae', 'Acid / 303', 'Funk',
          'Ambient', 'House', 'Breakbeat', 'Lo-fi hip-hop']
DIVISIONS = ['1/8 - osemki', '1/16 - szesnastki',
             '1/16T - triole szesnastek', '1/32 - trzydziestodwojki']
GATES = ['Staccato – urywane', 'Krótkie', 'Naturalne', 'Legato – łączone']
GATE_RATIOS = [0.32, 0.58, 0.85, 1.08]
COLORS = ['Trójdźwięki', 'Septymy (7)', 'Sus2 / Sus4', 'Add9']
VOICINGS = ['Blisko – zwarta harmonia', 'Szeroko – przestrzennie',
            'Voice leading – płynne przejścia']

# Names serve as descriptions; hints are visible in the native dialog help panel.
FIELD = {
    'mode': 'Partia muzyczna',
    'bars': 'Długość frazy – takty',
    'tonic': 'Tonika – dźwięk (C, D, E…)',
    'octave': 'Rejestr – wysokość / oktawa',
    'scale': 'Skala – charakter melodii',
    'progression': 'Progresja – kolejność akordów',
    'style': 'Styl – rodzaj groove’u',
    'division': 'Puls rytmiczny – podział nut',
    'density': 'Gęstość – ile nut / uderzeń',
    'swing': 'Swing – kołysanie rytmu',
    'human': 'Naturalność – odchylenia',
    'variation': 'Wariacje – rozwój frazy',
    'gate': 'Artykulacja – długość nut',
    'color': 'Harmonia – rodzaj akordu',
    'voicing': 'Układ akordów – rozłożenie',
    'seed': 'Wariant - numer pomyslu',
    'replace': 'Zastąp istniejące nuty',
}


def createDialog():
    f = flp.ScriptDialog(
        'JERZY COMPOSER 0.3',
        'Muzyczny generator: tonacja, progresje, groove, motywy i wariacje. '
        'Wybierz partie, a nuty pojawia sie bezposrednio w Piano Roll.'
    )
    f.addInputCombo(FIELD['mode'], MODES, 1,
                    hint='Wybierz, jaka partie chcesz napisac w aktualnym Piano Roll.')
    f.addInputKnobInt(FIELD['bars'], 4, 1, 32,
                      hint='Liczba taktow generowanej frazy.')
    f.addInputCombo(FIELD['tonic'], TONICS, 0,
                    hint='Tonika, czyli glowny dzwiek tonacji, np. C albo E.')
    f.addInputCombo(FIELD['octave'], OCTAVES, 1,
                    hint='Oktawa bazowa; zmienia wysokosc calej partii.')
    f.addInputCombo(FIELD['scale'], SCALE_NAMES, 0,
                    hint='Zestaw dzwiekow: moll, dur, dorycka i inne.')
    f.addInputCombo(FIELD['progression'], PROGRESSION_NAMES, 1,
                    hint='Nastepstwo akordow; zmienia rowniez bas i melodie.')
    f.addInputCombo(FIELD['style'], STYLES, 0,
                    hint='Rock, funk, dub, acid, ambient, house, breakbeat, lo-fi.')
    f.addInputCombo(FIELD['division'], DIVISIONS, 1,
                    hint='Drobniejszy podzial daje szybszy ruch nut lub hi-hatow.')
    f.addInputKnob(FIELD['density'], 0.72, 0.0, 1.0,
                   hint='Mniej = wiecej pauz; wiecej = gestsza partia.')
    f.addInputKnob(FIELD['swing'], 0.15, 0.0, 0.45,
                   hint='Opoznia wybrane slabe podzialy, tworzac kolysanie.')
    f.addInputKnob(FIELD['human'], 0.06, 0.0, 0.25,
                   hint='Subtelne zmiany czasu i sily uderzenia, nie przypadkowe dzwieki.')
    f.addInputKnob(FIELD['variation'], 0.35, 0.0, 1.0,
                   hint='Jak mocno kolejne takty rozwijaja podstawowy motyw.')
    f.addInputCombo(FIELD['gate'], GATES, 2,
                    hint='Staccato = krotko, legato = dzwieki laczone.')
    f.addInputCombo(FIELD['color'], COLORS, 0,
                    hint='Trojdzweki, septymy, zawieszenia lub dodatkowa nona.')
    f.addInputCombo(FIELD['voicing'], VOICINGS, 2,
                    hint='Gesty albo szeroki uklad; voice leading laczy akordy plynnie.')
    f.addInputKnobInt(FIELD['seed'], 71, 0, 999999,
                      hint='Ten sam numer + parametry = te same nuty.')
    f.addInputCheckbox(FIELD['replace'], True,
                       hint='UWAGA: usunie wybrane nuty, a bez zaznaczenia caly roll.')
    return f


def _value(form, key):
    return form.getInputValue(FIELD[key])


def _clamp(v, lo, hi):
    return max(lo, min(hi, v))


def _pitch(root, degree, scale):
    tones = SCALES[scale]
    size = len(tones)
    return root + 12 * (degree // size) + tones[degree % size]


def _root_for_degree(root, degree, scale):
    return _pitch(root, degree, scale)


def _add(pitch, time, length, velocity, color=0):
    p = int(round(pitch))
    if p < 0 or p > 127:
        return
    note = flp.Note()
    note.number = p
    note.time = max(0, int(round(time)))
    note.length = max(1, int(round(length)))
    note.velocity = _clamp(float(velocity), 0.04, 1.0)
    note.color = int(color) % 16
    flp.score.addNote(note)


def _time(pos, unit, swing, human, rng, max_time):
    idx = int(round(pos / unit))
    # Only offbeat subdivisions swing. Never jitter into the following bar.
    offset = unit * swing if idx % 2 else 0
    offset += rng.uniform(-human, human) * unit * 0.25
    return _clamp(pos + offset, 0, max(0, max_time - 1))


def _velocity(strong, human, rng):
    return _clamp(strong + rng.uniform(-0.12, 0.12) * human, 0.10, 0.99)


def _chord(root, degree, scale, color):
    if color == 1:
        tones = [0, 2, 4, 6]
    elif color == 2:
        tones = [0, 1, 4] if degree % 2 == 0 else [0, 3, 4]
    elif color == 3:
        tones = [0, 2, 4, 8]
    else:
        tones = [0, 2, 4]
    return [_pitch(root, degree + t, scale) for t in tones]


def _voice(chord, voicing, previous):
    # Bass in original octave, chords one octave up by default.
    candidates = []
    for shift in (-12, 0, 12):
        for inversion in range(len(chord)):
            ascending = chord[inversion:] + [p + 12 for p in chord[:inversion]]
            c = [p + shift for p in ascending]
            if voicing == 1 and len(c) >= 3:
                c[-1] += 12
            if min(c) < 30 or max(c) > 110:
                continue
            center_penalty = abs(sum(c) / len(c) - 65) * 0.15
            if voicing == 2 and previous:
                cost = sum(abs(a - b) for a, b in zip(c, previous))
                cost += abs(sum(c)/len(c) - sum(previous)/len(previous))
            else:
                cost = center_penalty + abs(inversion) * 0.4 + abs(shift) * 0.1
            candidates.append((cost, c))
    return min(candidates, key=lambda item: item[0])[1] if candidates else chord


def _params(form):
    ppq = int(flp.score.PPQ)
    try:
        numerator = int(flp.score.tsnum)
        denominator = int(flp.score.tsden)
    except AttributeError:
        numerator, denominator = 4, 4
    if numerator <= 0 or denominator <= 0:
        numerator, denominator = 4, 4
    bar = int(round(ppq * 4.0 * numerator / denominator))
    subdivision = int(_value(form, 'division'))
    unit = [ppq / 2.0, ppq / 4.0, ppq / 6.0, ppq / 8.0][subdivision]
    octave = int(_value(form, 'octave')) + 2  # MIDI C2=36, C3=48, ...
    return {
        'mode': int(_value(form, 'mode')),
        'bars': int(_value(form, 'bars')),
        'root': (octave + 1) * 12 + int(_value(form, 'tonic')),
        'scale': int(_value(form, 'scale')),
        'progression': PROGRESSIONS[int(_value(form, 'progression'))],
        'style': int(_value(form, 'style')),
        'unit': unit,
        'ppq': ppq,
        'bar': bar,
        'density': float(_value(form, 'density')),
        'swing': float(_value(form, 'swing')),
        'human': float(_value(form, 'human')),
        'variation': float(_value(form, 'variation')),
        'gate': GATE_RATIOS[int(_value(form, 'gate'))],
        'color': int(_value(form, 'color')),
        'voicing': int(_value(form, 'voicing')),
        'rng': random.Random(int(_value(form, 'seed'))),
    }


def _drums(p):
    rng = p['rng']
    bar = p['bar']
    max_time = bar * p['bars']
    # Preserve existing Jerzy Drum Machine note map: KICK=36 SN=37 CH=39 OH=43.
    patterns = [
        ((0, 8, 10), (4, 12)),      # rock
        ((0, 10), (4, 12)),         # dub
        ((0, 4, 8, 12), (4, 12)),  # acid
        ((0, 6, 10), (4, 12)),      # funk
        ((0, 8), (12,)),           # ambient
        ((0, 4, 8, 12), (4, 12)),  # house
        ((0, 7, 10), (4, 12)),      # breakbeat
        ((0, 8, 11), (4, 12)),      # lofi
    ]
    kicks, snares = patterns[p['style']]
    sixteenth = bar / 16.0
    for b in range(p['bars']):
        first = b * bar
        fill = b % 4 == 3
        for kind, steps, pitch, vel in ((0, kicks, 36, 0.93),
                                       (1, snares, 37, 0.88)):
            for s in steps:
                if (kind == 0 and s == 0) or rng.random() < (0.75 + 0.25 * p['density']):
                    t = _time(first + s*sixteenth, sixteenth,
                              p['swing']*0.2, p['human'], rng, max_time)
                    _add(pitch, t, sixteenth*0.58, _velocity(vel, p['human'], rng), kind)
        # Main rhythm stays stable. Variation is reserved for short fills / ghosts.
        if fill and rng.random() < p['variation']:
            for s in (13, 14, 15):
                if rng.random() < p['variation'] * 0.65:
                    _add(37, _time(first+s*sixteenth, sixteenth, 0.0,
                                   p['human'], rng, max_time),
                         sixteenth*0.38, 0.36+rng.random()*0.24, 1)
        hats_per_bar = max(1, int(round(bar / p['unit'])))
        for i in range(hats_per_bar):
            if rng.random() > (0.22 + 0.78*p['density']):
                continue
            at = first + i*bar/hats_per_bar
            step_in_beat = (i*bar/hats_per_bar) % p['ppq']
            strong = 0.77 if step_in_beat < 1 else 0.50
            if p['style'] == 4:
                strong *= 0.72
            t = _time(at, p['unit'], p['swing'], p['human'], rng, max_time)
            _add(39, t, p['unit']*0.42, _velocity(strong, p['human'], rng), 2)
        # Open hat/perc: contextual phrase ending, not an unconditional metronome.
        if p['style'] not in (4,) and rng.random() < p['density']*0.70:
            at = first + bar*0.875
            _add(43, _time(at, sixteenth, p['swing'], p['human'], rng, max_time),
                 sixteenth*1.6, 0.61, 3)


def _bass(p):
    rng = p['rng']
    bbar, root, scale = p['bar'], p['root'], p['scale']
    length = p['bars']*bbar
    # Events as fractions of the bar; degrees relative to the current chord.
    # Positive degrees are diatonic fifths, thirds and octaves.
    grooves = [
        [(0, 0), (0.25, 0), (0.50, 4), (0.75, 0)],
        [(0, 0), (0.375, 4), (0.75, 0)],
        [(0, 0), (0.125, 7), (0.25, 4), (0.375, 0), (0.625, 7), (0.75, 4)],
        [(0, 0), (0.1875, 4), (0.375, 7), (0.50, 0), (0.6875, 2), (0.875, 4)],
        [(0, 0), (0.50, 4)],
        [(0, 0), (0.25, 0), (0.50, 4), (0.75, 0)],
        [(0, 0), (0.1875, 0), (0.50, 4), (0.6875, 2), (0.875, 0)],
        [(0, 0), (0.375, 4), (0.75, 0)],
    ]
    events = []
    for b in range(p['bars']):
        degree = p['progression'][b % len(p['progression'])]
        following = p['progression'][(b+1) % len(p['progression'])]
        first = b*bbar
        for j, (fraction, chord_note) in enumerate(grooves[p['style']]):
            if j and rng.random() > (0.20 + p['density']*0.80):
                continue
            current_degree = degree + chord_note
            if (b % 2 == 1 and j > 0 and
                    rng.random() < p['variation']*0.3):
                current_degree += rng.choice([-1, 1])
            start = _time(first+fraction*bbar, p['unit'],
                          p['swing'], p['human'], rng, length)
            velocity = 0.92 if j == 0 else (0.75 if j % 2 else 0.83)
            events.append((start, _root_for_degree(root, current_degree, scale),
                           _velocity(velocity, p['human'], rng)))
        # Melodic approach anticipates the next chord rather than a random note.
        if b < p['bars']-1 and rng.random() < p['variation']*0.55:
            upcoming = following - 1 if following > degree else following + 1
            events.append((_time(first+bbar*0.9375, p['unit'],
                                 p['swing'], p['human'], rng, length),
                           _pitch(root, upcoming, scale), 0.50))
    events.sort(key=lambda x: x[0])
    for i, (start, note, velocity) in enumerate(events):
        next_start = events[i+1][0] if i+1 < len(events) else length
        max_dur = max(1, next_start-start)
        duration = min(max_dur, p['unit']*2.8*p['gate'])
        if p['style'] == 4:
            duration = max_dur * min(1.0, p['gate'])
        _add(note, start, duration, velocity, 0)


def _harmonic_events(p):
    rng = p['rng']
    previous = None
    for b in range(p['bars']):
        degree = p['progression'][b % len(p['progression'])]
        chord = _chord(p['root'] + 12, degree, p['scale'], p['color'])
        voiced = _voice(chord, p['voicing'], previous)
        previous = voiced
        bar = p['bar']
        first = b*bar
        if p['style'] == 4:  # ambient: long overhanging pads
            events = [(0.0, 0.98)]
        elif p['style'] == 1:  # reggae skank
            events = [(0.125, 0.24), (0.375, 0.24),
                      (0.625, 0.24), (0.875, 0.24)]
        elif p['style'] == 5:  # house offbeats
            events = [(0.125, 0.23), (0.375, 0.23),
                      (0.625, 0.23), (0.875, 0.23)]
        elif p['style'] in (3, 6):
            events = [(0.0, 0.19), (0.375, 0.17),
                      (0.625, 0.19), (0.875, 0.12)]
        elif p['style'] == 7:
            events = [(0.0, 0.42), (0.625, 0.26)]
        else:
            events = [(0.0, 0.45), (0.5, 0.44)]
        for j, (fraction, duration_fraction) in enumerate(events):
            if j and rng.random() > (0.25+0.75*p['density']):
                continue
            at = _time(first + bar*fraction, p['unit'],
                       p['swing'], p['human'], rng, p['bars']*bar)
            dur = min(p['bars']*bar-at, duration_fraction*bar*p['gate'])
            vel = _velocity(0.65 if j else 0.80, p['human'], rng)
            yield (at, dur, vel, voiced)


def _chords(p):
    for at, duration, velocity, chord in _harmonic_events(p):
        for pitch in chord:
            _add(pitch, at, duration, velocity, 1)


def _arp(p):
    rng = p['rng']
    prev = None
    length = p['bars']*p['bar']
    for b in range(p['bars']):
        degree = p['progression'][b % len(p['progression'])]
        chord = _voice(_chord(p['root']+12, degree, p['scale'], p['color']),
                       p['voicing'], prev)
        prev = chord
        steps = max(1, int(round(p['bar']/p['unit'])))
        # Stable contour within a bar; second bar can reverse direction.
        cycle = list(range(len(chord)))
        if b % 2 and rng.random() < p['variation']:
            cycle = list(reversed(cycle))
        if len(cycle) > 2 and p['style'] in (4, 7):
            cycle = cycle + cycle[-2:0:-1]
        for idx in range(steps):
            if idx != 0 and rng.random() > (0.18 + p['density']*0.82):
                continue
            pitch = chord[cycle[idx % len(cycle)]]
            if idx == steps-1 and rng.random() < p['variation']*0.5:
                pitch += 12
            at = _time(b*p['bar'] + idx*p['bar']/steps, p['unit'],
                       p['swing'], p['human'], rng, length)
            gate = p['gate'] if p['style'] != 4 else max(1.0, p['gate'])
            _add(pitch, at, min(p['unit']*gate, length-at),
                 _velocity(0.83 if idx % 4 == 0 else 0.65, p['human'], rng), 2)


def _melody(p):
    rng = p['rng']
    steps = max(1, int(round(p['bar']/p['unit'])))
    length = p['bars']*p['bar']
    # Two-bar call-and-response motif: same rhythmic identity,
    # harmonic transposition by the progression, sparse endings.
    rhythm = []
    contour = []
    degree = 0
    for s in range(steps):
        active = (s == 0 or rng.random() < (0.15 + p['density']*0.65))
        rhythm.append(active)
        if active:
            degree = _clamp(degree + rng.choice([-2, -1, 0, 0, 1, 2]), -3, 7)
        contour.append(degree)
    events = []
    for b in range(p['bars']):
        root_degree = p['progression'][b % len(p['progression'])]
        for s in range(steps):
            if not rhythm[s]:
                continue
            # Phrase breath: don't fill every bar with unbroken notes.
            if (b % 4 == 3 and s > steps*0.72) or (
                    b % 2 and s > steps*0.8 and rng.random() < 0.6):
                continue
            offset = contour[s]
            if b % 2:
                offset = -offset if p['style'] in (4, 7) else offset
            if b >= 2 and s != 0 and rng.random() < p['variation']*0.35:
                offset += rng.choice([-1, 1])
            if s == 0 or (b % 4 == 3 and s >= steps//2):
                offset = 0  # arrival note resolves to current chord root
            pitch = _pitch(p['root']+12, root_degree+offset, p['scale'])
            at = _time(b*p['bar'] + s*p['bar']/steps, p['unit'],
                       p['swing'], p['human'], rng, length)
            events.append((at, pitch,
                           _velocity(0.84 if s == 0 else 0.70, p['human'], rng)))
    events.sort(key=lambda x: x[0])
    for i, (at, pitch, velocity) in enumerate(events):
        until = (events[i+1][0] - at) if i+1 < len(events) else length-at
        duration = min(max(1, until), p['unit']*p['gate']*(2 if i%5 == 0 else 1))
        _add(pitch, at, duration, velocity, 3)


def apply(form):
    p = _params(form)
    if _value(form, 'replace'):
        flp.score.clearNotes(True)
    generators = [_drums, _bass, _chords, _arp, _melody]
    generators[p['mode']](p)
