"""FL Piano Roll JPF import. Does not require installing Python packages in FL Studio."""
import json
import flpianoroll as flp

def createDialog():
    f=flp.ScriptDialog('Jerzy Import Pattern','Load one track from a JPF .json pattern file')
    f.addInputText('JPF file path',r'C:\JerzyFL\pattern.jpf.json')
    f.addInputKnobInt('Track number (1-based)',1,1,128)
    f.addInputCheckbox('Clear Piano Roll first',False)
    return f

def apply(f):
    try:
        with open(f.getInputValue('JPF file path'),'r',encoding='utf-8') as fp:p=json.load(fp)
        if p.get('format')!='jerzy-pattern' or p.get('version')!=1 or p.get('ppq')!=960:return
        track=p['tracks'][f.getInputValue('Track number (1-based)')-1]
        if f.getInputValue('Clear Piano Roll first'):flp.score.clearNotes(True)
        for event in track['notes']:
            n=flp.Note();n.number=event['key'];n.time=round(event['start']*flp.score.PPQ/960)
            n.length=max(1,round(event['length']*flp.score.PPQ/960))
            n.velocity=max(0.,min(1.,event['velocity']/127.0));n.color=track.get('channel',0)
            flp.score.addNote(n)
    except Exception as exc:flp.Utils.log('Jerzy JPF import failed: '+str(exc))
