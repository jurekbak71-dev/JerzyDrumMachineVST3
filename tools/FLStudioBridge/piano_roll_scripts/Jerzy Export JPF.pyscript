"""FL Piano Roll JPF export: one active/current Piano Roll instrument; writes on Apply."""
import json
import flpianoroll as flp

def createDialog():
    f=flp.ScriptDialog('Jerzy Export Pattern','Export active Piano Roll as Jerzy Pattern Format')
    f.addInputText('Save JPF file as',r'C:\JerzyFL\pattern.jpf.json')
    f.addInputText('Track name','Piano Roll')
    f.addInputKnobInt('BPM',120,20,400)
    return f

def apply(f):
    try:
        tracks={}
        for i in range(flp.score.noteCount):
            n=flp.score.getNote(i)
            ch=n.color
            track=tracks.setdefault(ch,{'name':f.getInputValue('Track name')+' ch'+str(ch+1),
                'channel':ch,'notes':[]})
            track['notes'].append({'key':n.number,'start':round(n.time*960/flp.score.PPQ),
                'length':max(1,round(n.length*960/flp.score.PPQ)),
                'velocity':max(1,min(127,round(n.velocity*127)))})
        doc={'format':'jerzy-pattern','version':1,'ppq':960,'name':'Export from FL Studio',
             'bpm':f.getInputValue('BPM'),'time_signature':[flp.score.tsnum,flp.score.tsden],'tracks':[tracks[k] for k in sorted(tracks)]}
        with open(f.getInputValue('Save JPF file as'),'w',encoding='utf-8') as out:
            json.dump(doc,out,ensure_ascii=False,indent=2)
    except Exception as exc:flp.Utils.log('Jerzy JPF export failed: '+str(exc))
